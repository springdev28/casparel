# Casparel API server — example environment
# Copy to `.env` (gitignored) and fill in. Only the "Core" group is required
# to boot; the rest have safe defaults.

# ── Core (required) ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/casparel
SESSION_SECRET=change-me-to-a-long-random-string
# PORT defaults to 8080 (Replit) / 5000 (local); never hardcode it elsewhere.

# These two are genuinely required to BOOT, not just to use AI features.
# lib/integrations-openai-ai-server throws from module scope when either is
# missing, and routes/resources.ts imports it at the top level, so the process
# exits during startup with no HTTP server and no /healthz to ask. Leaving them
# out of this file made that look like a mysterious crash rather than a missing
# variable. Point BASE_URL at api.openai.com/v1 unless you proxy the API.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-change-me

# ── RevenueCat webhook (server-side entitlement reconciliation) ───────────────
# Shared secret. Set the SAME value here and in the RevenueCat dashboard
# (Webhooks → Authorization header). If unset, POST /api/webhooks/revenuecat
# returns 503 and refuses to process events. See docs/shipaton-2026-roadmap.md §5.
REVENUECAT_WEBHOOK_AUTH=change-me-to-a-long-random-string
# RevenueCat secret key used only by the server to reconcile TRANSFER events.
REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_key

# ── AI usage limits (Free has no AI; Plus is capped; Pro/admin are uncapped) ─
AI_RESOURCE_SEARCH_ENABLED=true       # optional AI fallback for resource discovery
AI_PUBLIC_PROFILE_SEARCH_ENABLED=false # optional AI fallback for people discovery
AI_PLUS_SEARCH_DAILY_LIMIT=20       # Plus AI discovery searches / day
AI_PLUS_DEEP_DAILY_LIMIT=5          # Plus deep-research reports / day
AI_PLUS_DEEP_MONTHLY_LIMIT=50       # Plus deep-research reports / rolling 30 days
AI_SEARCH_DAILY_LIMIT=20           # global AI discovery budget / day
AI_DEEP_DAILY_GLOBAL_LIMIT=20      # global deep-research budget / day (safety net)

# ── Google integrations (optional — Calendar / Classroom sync) ────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_CAL_REDIRECT_URI=

# ── Misc (optional) ──────────────────────────────────────────────────────────
# ADMIN_EMAILS=admin@example.com          # comma-separated admin allowlist
# ALLOWED_ORIGINS=https://casparel.com     # CORS allowlist
# APP_URL=https://casparel.com
# LOG_LEVEL=info

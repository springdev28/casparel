{
  "expo": {
    "name": "Casparel",
    "slug": "casparel",
    "version": "1.0.0",
    "description": "Knowledge is treasure. An intelligent education platform that brings classes, resources, research, planning, and progress into one connected workspace.",
    "primaryColor": "#2f4cc8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "casparel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8f7f4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.casparel.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Casparel needs access to your photos so you can set a profile picture."
      }
    },
    "android": {
      "package": "com.casparel.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://casparel.com"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

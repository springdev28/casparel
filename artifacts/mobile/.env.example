# Casparel mobile — example environment
# Copy to `.env` (gitignored) for local builds, or set these as EAS
# environment variables / secrets for `eas build`.

# ── RevenueCat (public SDK keys — safe to ship in the client bundle) ──────────
# From RevenueCat dashboard → Project → API keys → "Public app-specific" keys.
# The app reads the platform-matching key at runtime (see utils/revenuecat.ts).
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── API host ─────────────────────────────────────────────────────────────────
# The domain the app points its API client at. In Replit dev this is provided
# automatically (EXPO_PUBLIC_DOMAIN); set it explicitly for standalone builds.
# EXPO_PUBLIC_DOMAIN=api.casparel.app

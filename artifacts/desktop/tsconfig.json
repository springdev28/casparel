{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    // Inside the output directory, so that deleting the output also deletes
    // the record of having produced it. The workspace compiles incrementally;
    // with the cache alongside the sources instead, `rm -rf dist` left a
    // manifest saying every file was already emitted, and the next compile
    // exited 0 having written nothing at all. What electron-builder then
    // packaged was whatever `dist` held, which in that state was nothing.
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Electron's main process is CommonJS. node16 resolution keeps the
    // workspace's customConditions working while still emitting CJS, because
    // this package has no "type": "module".
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["esnext"],
    "types": ["node"],
    "skipLibCheck": true
  }
}

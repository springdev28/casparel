{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "EduDS design tokens — educational student/teacher app. Trustworthy deep-blue primary, teal-green accent, warm neutral backgrounds, dense-information-ready typography. Edit here only — the dev server regenerates src/index.css and src/generated/tokens.tsx on change.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f8f7f4", "$description": "Warm off-white page background — easier on the eyes during long study sessions." },
      "foreground": { "$value": "#1a1917", "$description": "Warm near-black for primary text." },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#1a1917" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#1a1917" },
      "primary": {
        "$value": "#1e40af",
        "$description": "Deep academic blue — trustworthy, focused, authoritative. Drives primary buttons and key actions."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#eeeae4", "$description": "Warm stone — secondary surfaces and softer actions." },
      "secondaryForeground": { "$value": "#1a1917" },
      "muted": { "$value": "#eeeae4" },
      "mutedForeground": { "$value": "#6b6560" },
      "accent": {
        "$value": "#0d9488",
        "$description": "Teal-green — growth, progress, completion. Accent actions and highlights."
      },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#dc2626" },
      "destructiveForeground": { "$value": "#ffffff" },
      "border": { "$value": "#e2ddd8" },
      "input": { "$value": "#e2ddd8" },
      "ring": { "$value": "#1e40af" },
      "chart1": { "$value": "#1e40af", "$description": "Blue — primary series." },
      "chart2": { "$value": "#0d9488", "$description": "Teal — secondary series." },
      "chart3": { "$value": "#d97706", "$description": "Amber — tertiary / warning series." },
      "chart4": { "$value": "#7c3aed", "$description": "Purple — quaternary series." },
      "chart5": { "$value": "#059669", "$description": "Emerald — fifth series / success." },
      "sidebar": { "$value": "#eeeae4", "$description": "Warm stone sidebar — distinct from main content without being harsh." },
      "sidebarForeground": { "$value": "#3d3a36" },
      "sidebarBorder": { "$value": "#ddd9d3" },
      "sidebarPrimary": { "$value": "#1e40af" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#ddd9d3" },
      "sidebarAccentForeground": { "$value": "#1a1917" },
      "sidebarRing": { "$value": "#1e40af" }
    },
    "dark": {
      "background": { "$value": "#0f1117", "$description": "Deep navy-dark — easier on the eyes for late-night studying." },
      "foreground": { "$value": "#ede9e3", "$description": "Warm off-white text on dark backgrounds." },
      "card": { "$value": "#1a1e2a" },
      "cardForeground": { "$value": "#ede9e3" },
      "popover": { "$value": "#1a1e2a" },
      "popoverForeground": { "$value": "#ede9e3" },
      "primary": {
        "$value": "#6096e8",
        "$description": "Lighter academic blue for dark mode — keeps the brand hue legible."
      },
      "primaryForeground": { "$value": "#0f1117" },
      "secondary": { "$value": "#272b38" },
      "secondaryForeground": { "$value": "#ede9e3" },
      "muted": { "$value": "#272b38" },
      "mutedForeground": { "$value": "#9b9590" },
      "accent": {
        "$value": "#2dd4bf",
        "$description": "Bright teal for dark mode — retains energy and legibility."
      },
      "accentForeground": { "$value": "#0f1117" },
      "destructive": { "$value": "#991b1b" },
      "destructiveForeground": { "$value": "#fef2f2" },
      "border": { "$value": "#2e3240" },
      "input": { "$value": "#2e3240" },
      "ring": { "$value": "#6096e8" },
      "chart1": { "$value": "#6096e8" },
      "chart2": { "$value": "#2dd4bf" },
      "chart3": { "$value": "#fbbf24" },
      "chart4": { "$value": "#a78bfa" },
      "chart5": { "$value": "#34d399" },
      "sidebar": { "$value": "#141820", "$description": "Slightly lighter than background to carve out the nav." },
      "sidebarForeground": { "$value": "#ccc8c2" },
      "sidebarBorder": { "$value": "#2e3240" },
      "sidebarPrimary": { "$value": "#6096e8" },
      "sidebarPrimaryForeground": { "$value": "#0f1117" },
      "sidebarAccent": { "$value": "#272b38" },
      "sidebarAccentForeground": { "$value": "#ede9e3" },
      "sidebarRing": { "$value": "#6096e8" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Space Grotesk", "Inter", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Modern technical grotesk with Latin Extended coverage, including Turkish characters, plus robust system fallbacks."
      },
      "serif": {
        "$value": ["Source Serif 4", "serif"],
        "$description": "Academic serif — long-form reading, article bodies, resource excerpts."
      },
      "mono": {
        "$value": ["JetBrains Mono", "monospace"],
        "$description": "Developer-friendly mono — code snippets, resource IDs, keyboard shortcuts."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Moderate radius — professional and approachable, not overly rounded or harsh."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step the shadcn components multiply."
    }
  }
}

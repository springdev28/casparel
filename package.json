{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm --filter @workspace/app run build && pnpm --filter @workspace/api-server run build",
    "build:all": "pnpm run typecheck && pnpm -r --if-present run build",
    "dev:app": "bash scripts/run-schoolar.sh",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5.0.8": "5.0.9",
      "fast-uri@3.1.4": ">=4.1.2",
      "esbuild>@esbuild/darwin-arm64": "-",
      "esbuild>@esbuild/darwin-x64": "-",
      "esbuild>@esbuild/freebsd-arm64": "-",
      "esbuild>@esbuild/freebsd-x64": "-",
      "esbuild>@esbuild/linux-arm": "-",
